PORT=3000

# 1. Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pool.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 2. Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3="https://your-project-id.storage.c-3.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="your_region"
AWS_BUCKET_NAME="executablefiles"
